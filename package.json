{
  "name": "@yu1745/dsh-extensions",
  "version": "0.1.0-alpha.1",
  "description": "Web search and reader, quota charts, USD cost tracking and session Codex speed modes for DSH",
  "type": "module",
  "license": "MIT",
  "author": "yu1745",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yu1745/dsh-extensions.git"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "presets",
    "NOTICE.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./web-search": "./lib/web-search.js",
    "./web-reader": "./lib/web-reader.js",
    "./quota": "./lib/quota.js",
    "./codex-fast": "./lib/codex-fast.js",
    "./package.json": "./package.json",
    "./web-tools": "./lib/web-tools.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-alpha.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "format": "prettier --write src/*.ts src/*.tsx scripts/*.mjs tests/*.mjs"
  },
  "dependencies": {
    "typebox": "1.1.38",
    "playwright": "1.61.0",
    "undici": "^8.10.1",
    "https-proxy-agent": "^7.0.6",
    "zod": "^4.3.6",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^6.0.3",
    "@types/node": "^25.9.1",
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.4",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "@types/react": "^18.3.0",
    "@earendil-works/pi-ai": "1.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.4",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.4",
    "@earendil-works/pi-ai": "1.2.0"
  }
}
